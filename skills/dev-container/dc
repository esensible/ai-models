#!/usr/bin/env bash
# dc — launch / manage a remote-control Claude agent in an ai-models dev container.
#
#   dc ls                    list containers + which repo each mounts at /workspace
#   dc start  <container>    start a stopped container
#   dc stop   <container>    stop a container (graceful; reversible)
#   dc agent  <container>    launch a FRESH remote-control session in /workspace
#   dc resume <container>    relaunch, RESUMING the real prior session by id (never blank)
#   dc kill   <container>    stop the agent session (leaves the container running)
#
# The container is expected to be an ai-models dev container (from .devcontainer/): the
# ai-models repo bind-mounted at /workspace, git/uv/python3 + an AUTHENTICATED claude on
# PATH (a persisted /root/.claude/.credentials.json — via the dot_claude volume after a
# one-time `claude` login). Image-agnostic: drives a container by name.
#
# The launch/resume recipe mirrors silvin's `.claude/skills/worktree` skill and the personal
# `dev-containers` skill — this is the ai-models wrapper so you don't hand-roll it.
set -euo pipefail

RC_NAME="ai-models"                 # remote-control session name (shown in the Claude app)
WS="/workspace"                     # bind-mounted repo, per .devcontainer/devcontainer.json
CE="${DC_RUNTIME:-podman}"          # runtime; override: DC_RUNTIME=docker

die() { echo "dc: $*" >&2; exit 1; }
need_running() { $CE ps --format '{{.Names}}' | grep -qxF "$1" || die "not running: $1  (try: dc start $1)"; }

preflight() {   # verify the container is a usable, authenticated ai-models box
  local c="$1"
  need_running "$c"
  local url; url="$($CE exec "$c" git -C "$WS" remote get-url origin 2>/dev/null || true)"
  case "$url" in *ai-models*) : ;; *) die "$c: $WS is not an ai-models checkout (origin=${url:-none}) — create it from .devcontainer/";; esac
  for b in git uv python3 claude; do
    $CE exec "$c" bash -lc "command -v $b >/dev/null 2>&1" || die "$c: missing required tool: $b"
  done
  $CE exec "$c" bash -lc 'test -s "${CLAUDE_CONFIG_DIR:-/root/.claude}/.credentials.json"' \
    || die "$c: claude is not authenticated — run 'claude' once in the container to log in (persists in the dot_claude volume)"
}

launch() {   # launch <container> [resume_id]
  local c="$1" rid="${2:-}" resume=""
  [ -n "$rid" ] && resume="--resume $rid "
  # Write the launcher inside the container; run it detached under a PTY.
  # TERM=xterm-256color (dumb hangs the TUI); sleep infinity keeps stdin open;
  # script -qfec = flushing PTY; --debug-file lets us confirm the bridge state.
  $CE exec -i "$c" bash -c "cat > /root/launch-rc.sh" <<LAUNCH
#!/bin/bash
cd $WS || exit 1
export TERM=xterm-256color
sleep infinity | script -qfec 'claude ${resume}--remote-control $RC_NAME --debug-file /root/rc.debug.log' /root/rc.log
LAUNCH
  $CE exec "$c" rm -f /root/rc.log /root/rc.debug.log
  $CE exec -d "$c" setsid bash /root/launch-rc.sh
  if $CE exec "$c" bash -lc 'for i in $(seq 1 45); do grep -qi "state=connected" /root/rc.debug.log 2>/dev/null && exit 0; sleep 1; done; exit 1'; then
    echo "dc: '$RC_NAME' connected in '$c'. Open the Claude app -> remote sessions -> '$RC_NAME'."
    [ -z "$rid" ] && echo "dc: fresh session — accept the one-time folder-trust prompt from the app on first connect."
  else
    die "did not reach state=connected within 45s — inspect: $CE exec $c cat /root/rc.debug.log"
  fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
  ls|list)
    $CE ps -a --format '{{.Names}}\t{{.Image}}\t{{.Status}}'
    echo "--- /workspace repo (running containers) ---"
    for c in $($CE ps --format '{{.Names}}'); do
      echo "  $c -> $($CE exec "$c" git -C "$WS" remote get-url origin 2>/dev/null || echo n/a)"
    done
    ;;

  start) $CE start "${1:?usage: dc start <container>}" ;;
  stop)  $CE stop  "${1:?usage: dc stop <container>}" ;;

  agent)  c="${1:?usage: dc agent <container>}";  preflight "$c"; launch "$c" ;;

  resume)
    c="${1:?usage: dc resume <container>}"; preflight "$c"
    # The launcher runs in /workspace, so transcripts live under projects/-workspace.
    # Biggest .jsonl = the real prior session (a blank relaunch leaves a newer empty one).
    id="$($CE exec "$c" bash -lc 'd="${CLAUDE_CONFIG_DIR:-/root/.claude}/projects/-workspace"; ls -S "$d"/*.jsonl 2>/dev/null | head -1 | xargs -r basename | sed "s/\.jsonl$//"')"
    [ -n "$id" ] || die "$c: no prior session found — use 'dc agent' to start a fresh one"
    echo "dc: resuming session $id"
    launch "$c" "$id"
    ;;

  kill)
    c="${1:?usage: dc kill <container>}"; need_running "$c"
    # Kill by explicit PID (a script's cmdline is the script path, so pgrep here is safe
    # from the pkill-f self-match trap).
    pids="$($CE exec "$c" pgrep -f "remote-control $RC_NAME" 2>/dev/null || true)"
    sleeps="$($CE exec "$c" pgrep -f 'sleep infinity' 2>/dev/null || true)"
    [ -n "${pids}${sleeps}" ] || { echo "dc: no '$RC_NAME' session in '$c'"; exit 0; }
    $CE exec "$c" kill $pids $sleeps 2>/dev/null || true
    echo "dc: killed '$RC_NAME' in '$c' (container left running)"
    ;;

  *) echo "usage: dc {ls | start <c> | stop <c> | agent <c> | resume <c> | kill <c>}" >&2; exit 1 ;;
esac
